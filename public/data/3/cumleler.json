{"unite-1":[{"en":"Hello!","tr":"Merhaba!"},{"en":"Good morning.","tr":"Günaydın."},{"en":"Good afternoon.","tr":"Tünaydın."},{"en":"Good evening.","tr":"İyi akşamlar."},{"en":"Good night.","tr":"İyi geceler."},{"en":"Goodbye.","tr":"Hoşça kal."},{"en":"See you.","tr":"Görüşürüz."},{"en":"Take care.","tr":"Kendine iyi bak."},{"en":"Have a good day.","tr":"İyi günler."},{"en":"Nice to meet you.","tr":"Tanıştığıma memnun oldum."},{"en":"My name is Ece.","tr":"Benim adım Ece."},{"en":"What is your name?","tr":"Adın ne?"},{"en":"How are you today?","tr":"Bugün nasılsın?"},{"en":"I am fine, thank you.","tr":"İyiyim, teşekkür ederim."},{"en":"How old are you?","tr":"Kaç yaşındasın?"},{"en":"I am eight years old.","tr":"Sekiz yaşındayım."},{"en":"Can you spell your name?","tr":"Adını heceleyebilir misin?"},{"en":"My name is A-L-I.","tr":"Adım A-L-I diye hecelenir."},{"en":"I am a student.","tr":"Ben bir öğrenciyim."},{"en":"Let's count from one to twenty.","tr":"Birden yirmiye kadar sayalım."}],"unite-10":[{"en":"This is a bee.","tr":"Bu bir arıdır."},{"en":"The bear is big.","tr":"Ayı büyüktür."},{"en":"The frog is green.","tr":"Kurbağa yeşildir."},{"en":"The snake is long.","tr":"Yılan uzundur."},{"en":"A dolphin can swim.","tr":"Bir yunus yüzebilir."},{"en":"A butterfly can fly.","tr":"Bir kelebek uçabilir."},{"en":"The lion lives in nature.","tr":"Aslan doğada yaşar."},{"en":"Do you like whales?","tr":"Balinaları sever misin?"},{"en":"Yes, I love dolphins.","tr":"Evet, yunusları çok severim."},{"en":"No, I dislike spiders.","tr":"Hayır, örümcekleri sevmem."},{"en":"How many ducks are there?","tr":"Kaç ördek var?"},{"en":"There are four ducks.","tr":"Dört ördek var."},{"en":"The horse can run.","tr":"At koşabilir."},{"en":"The shark cannot fly.","tr":"Köpek balığı uçamaz."},{"en":"The bear is in the cave.","tr":"Ayı mağaradadır."},{"en":"The elephant is near the river.","tr":"Fil nehrin yakınındadır."},{"en":"The seagull flies over the sea.","tr":"Martı denizin üzerinde