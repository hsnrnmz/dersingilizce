":"She has got a desk in her room.","tr":"Onun odasında bir çalışma masası var."},{"en":"The pillow is on the bed in the bedroom.","tr":"Yastık yatak odasındaki yatağın üzerindedir."},{"en":"The kettle is next to the sink in the kitchen.","tr":"Su ısıtıcısı mutfakta lavabonun yanındadır."},{"en":"The shampoo and soap are in the bathroom.","tr":"Şampuan ve sabun banyodadır."},{"en":"The rectangular carpet is under the table.","tr":"Dikdörtgen halı masanın altındadır."},{"en":"My house has got a kitchen, a bedroom and a garden.","tr":"Evimde bir mutfak, bir yatak odası ve bir bahçe var."}],"unite-7":[{"en":"This is my city.","tr":"Bu benim şehrim."},{"en":"The school is here.","tr":"Okul burada."},{"en":"The park is over there.","tr":"Park şurada."},{"en":"I am at the library.","tr":"Kütüphanedeyim."},{"en":"She is in the hospital.","tr":"O hastanededir."},{"en":"He is at the bus stop.","tr":"O otobüs durağındadır."},{"en":"The cafe is in the town.","tr":"Kafe kasabadadır."},{"en":"Where is the museum?","tr":"Müze nerede?"},{"en":"The museum is over here.","tr":"Müze burada."},{"en":"Where are you now?","tr":"Şimdi neredesin?"},{"en":"I am at the shopping centre.","tr":"Alışveriş merkezindeyim."},{"en":"Where is she now?","tr":"O şimdi nerede?"},{"en":"She is at the post office.","tr":"O postanededir."},{"en":"The police station is in the city.","tr":"Polis merkezi şehirdedir."},{"en":"The bakery is near the market.","tr":"Fırın marketin yakınındadır."},{"en":"The swimming pool is next to the stadium.","tr":"Yüzme havuzu stadyumun yanındadır."},{"en":"The mosque and the hotel are in the town.","tr":"Cami ve otel kasabadadır."},{"en":"I am at the cinema, but my friend is at the zoo.","tr":"Ben sinemadayım ama arkadaşım hayvanat bahçesinde."},{"en":"Sorry, I do not know where the restaurant is.","tr":"Üzgünüm, restoranın nerede olduğunu bilmiyorum."},{"en":"The bank is over there, near the chemist's.","tr":"Banka şurada, eczanenin yakınında."}],"unite-8":[{"en":"This is a car.","tr":"Bu bir araba."},{"en":"The bus is on the road.","tr":"Otobüs yoldadır."},{"en":"The plane is in the sky.","tr":"Uçak gökyüzündedir."},{"en":"The ship is on the sea.","tr":"Gemi denizdedir."},{"en":"The train is at the station.","tr":"Tren istasyondadır."},{"en":"My bike is here.","tr":"Bisikletim burada."},{"en":"The helicopter is there.","tr":"Helikopter şurada."},{"en":"Where is the boat?","tr":"Tekne nerede?"},{"en":"It is on the river.","tr":"O nehir üzerindedir."},{"en":"How can I go to school?","tr":"Okula nasıl gidebilirim?"},{"en":"You can go by bus.","tr":"Otobüsle gidebilirsin."},{"en":"How can I get to the zoo?","tr":"Hayvanat bahçesine nasıl gidebilirim?"},{"en":"You can go by bike.","tr":"Bisikletle gidebilirsin."},{"en":"I can go on foot.","tr":"Yürüyerek gidebilirim."},{"en":"You can take a plane to Rome.","tr":"Roma'ya uçakla gidebilirsin."},{"en":"The lorry and the motorbike are on land.","tr":"Kamyon ve motosiklet karadadır."},{"en":"The canoe is on the river, near the boat.","tr":"Kano nehirde, teknenin yakınındadır."},{"en":"You can take a train from the station.","tr":"İstasyondan trene binebilirsin."},{"en":"I go to the park by scooter.","tr":"Parka scooter ile giderim."},{"en":"We can get to the island by ship or boat.","tr":"Adaya gemiyle veya tekneyle gidebiliriz."}],"unite-9":[{"en":"It is sunny.","tr":"Hava güneşli."},{"en":"It is rainy.","tr":"Hava yağmurlu."},{"en":"It is cloudy.","tr":"Hava bulutlu."},{"en":"It is snowy.","tr":"Hava karlı."},{"en":"It is windy.","tr":"Hava rüzgârlı."},{"en":"The weather is cold.","tr":"Hava soğuk."},{"en":"Summer is hot.","tr":"Yaz sıcaktır."},{"en":"How is the weather today?","tr":"Bugün hava nasıl?"},{"en":"It is warm and sunny.","tr":"Hava ılık ve güneşli."},{"en":"Is it foggy?","tr":"Hava sisli mi?"},{"en":"No, it is cloudy.","tr":"Hayır, hava bulutlu."},{"en":"Winter is freezing and snowy.","tr":"Kış dondurucu ve karlıdır."},{"en":"Spring is warm and rainy.","tr":"İlkbahar ılık ve ya